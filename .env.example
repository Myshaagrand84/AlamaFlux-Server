# Copy to .env (or set these in your host's environment) before running in production.

# Port the server listens on
PORT=8000

# Secret used to sign login tokens. MUST be a long random string in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# How long a login stays valid
TOKEN_TTL=12h

# The owner (super-admin) account, created automatically on first run.
OWNER_EMAIL=owner@yourschool.com
OWNER_PASSWORD=change-this-strong-password

# ---------- Email alerts (optional) ----------
# When a teacher's account is suspended, reactivated, force-signed-out, or
# removed, AlamaFlux emails the affected teacher automatically.
# If you leave these blank, emails are NOT actually sent — instead each one is
# logged to the console and saved as an .html/.txt file under data/emails/ so
# you can still see exactly what would have gone out. Fill these in to send for real.
#
# Example for Gmail (use an App Password, not your normal password):
#   EMAIL_SMTP_HOST=smtp.gmail.com
#   EMAIL_SMTP_PORT=587
#   EMAIL_SMTP_USER=you@gmail.com
#   EMAIL_SMTP_PASS=your-16-char-app-password
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
# The "From" address shown to recipients. Defaults to the SMTP user if blank.
EMAIL_FROM=AlamaFlux <no-reply@yourschool.com>
